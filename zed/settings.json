{
  "theme": "VSCode Dark Modern",

  "icon_theme": "Material Icon Theme",

  "buffer_font_family": "FiraCode Nerd Font Mono",
  "buffer_font_size": 16,
  "buffer_font_features": {
    "calt": true,
    "liga": true
  },

  "theme_overrides": {
    "VSCode Dark Modern": {
      "background": "#0D0D0D",
      "editor.background": "#0D0D0D",
      "editor.gutter.background": "#0D0D0D",

      "title_bar.background": "#0D0D0D",
      "toolbar.background": "#0D0D0D",

      "panel.background": "#0D0D0D",
      "panel.focused_border": "#0D0D0D",

      "tab_bar.background": "#0D0D0D",
      "tab.active_background": "#0D0D0D",
      "tab.inactive_background": "#0D0D0D",
      "status_bar.background": "#0D0D0D",
      "terminal.background": "#0D0D0D",
      "elevated_surface.background": "#0D0D0D",

      "border": "#0D0D0D",
      "border.variant": "#0D0D0D",

      "scrollbar.track.background": "#0D0D0D",

      "ghost_element.background": "#0D0D0D",

      "editor.active_line.background": "#101010",

      "editor.line_number": "#666666",
      "editor.active_line_number": "#D4D4D4"
    }
  },

  "terminal": {
    "font_family": "FiraCode Nerd Font Mono",
    "font_size": 16,
    "cursor_shape": "bar"
  }
}
